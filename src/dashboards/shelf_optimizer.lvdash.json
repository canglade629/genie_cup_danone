{
  "datasets": [
    {
      "name": "ds_summary",
      "displayName": "Portfolio summary",
      "queryLines": [
        "SELECT COUNT(*) AS total_stores,\n",
        "       SUM(CASE WHEN priority_tier IN ('critical', 'high') THEN 1 ELSE 0 END) AS urgent_stores,\n",
        "       ROUND(AVG(danone_sos_pct), 3) AS avg_danone_sos,\n",
        "       ROUND(AVG(compliance_pct) / 100.0, 3) AS avg_compliance\n",
        "FROM stores"
      ]
    },
    {
      "name": "ds_stores",
      "displayName": "Store priorities",
      "queryLines": [
        "SELECT store_id, store_name, city, retailer, format, lat, lng,\n",
        "       priority_tier, priority_score, danone_sos_pct,\n",
        "       compliance_pct, weekly_sales_eur, situation_summary\n",
        "FROM stores\n",
        "ORDER BY priority_score DESC"
      ]
    },
    {
      "name": "ds_lift",
      "displayName": "Estimated revenue lift",
      "queryLines": [
        "WITH shelf AS (\n",
        "  SELECT store_id, COUNT(*) AS total_slots,\n",
        "         SUM(CASE WHEN manufacturer = 'Empty' THEN 1 ELSE 0 END) AS empty_slots,\n",
        "         SUM(CASE WHEN manufacturer = 'Danone' AND shelf_zone != 'eye' THEN 1 ELSE 0 END) AS danone_below_eye\n",
        "  FROM planogram_slots GROUP BY store_id\n",
        ")\n",
        "SELECT s.store_name, s.priority_tier,\n",
        "       ROUND(s.weekly_sales_eur * 0.03 * sh.empty_slots / sh.total_slots, 0) AS oos_lift_eur,\n",
        "       ROUND(s.weekly_sales_eur * 0.12 * sh.danone_below_eye / sh.total_slots, 0) AS eye_level_lift_eur,\n",
        "       ROUND(s.weekly_sales_eur * 0.05 * (100 - s.compliance_pct) / 100.0, 0) AS compliance_lift_eur\n",
        "FROM stores s JOIN shelf sh ON s.store_id = sh.store_id\n",
        "ORDER BY oos_lift_eur + eye_level_lift_eur + compliance_lift_eur DESC"
      ]
    },
    {
      "name": "ds_shelf",
      "displayName": "Share of shelf",
      "queryLines": [
        "SELECT manufacturer, COUNT(*) AS facings,\n",
        "       ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 1) AS share_of_shelf_pct,\n",
        "       SUM(CASE WHEN shelf_zone = 'eye' THEN 1 ELSE 0 END) AS eye_level_facings\n",
        "FROM planogram_slots\n",
        "GROUP BY manufacturer ORDER BY facings DESC"
      ]
    },
    {
      "name": "ds_signals",
      "displayName": "External demand signals",
      "queryLines": [
        "SELECT s.store_name, s.priority_tier, e.source_name, e.signal_summary,\n",
        "       e.signal_score, e.demand_theme, e.recommended_action,\n",
        "       e.expected_impact, e.urgency, e.valid_from, e.valid_to\n",
        "FROM external_signals e JOIN stores s ON e.store_id = s.store_id\n",
        "ORDER BY e.signal_score DESC"
      ]
    }
  ],
